:host {
  display: block;
  .theme-covoiturage {
    max-width: 900px;
    margin: 0 auto;
  }
  .route-card .card-header {
    padding: 0.4rem 0.6rem;
  }
  .route-card .card-header h5 {
    font-size: 0.95rem;
  }
  .route-card .card-body {
    padding: 0.4rem 0.6rem;
    font-size: 0.85rem;
  }
  .pagination .page-link {
    padding: 0.2rem 0.55rem;
    font-size: 0.8rem;
  }
}