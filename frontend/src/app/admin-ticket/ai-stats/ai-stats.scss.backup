.ai-stats-page {
  max-width: 1100px;
  margin: 0 auto;
  padding: 20px;
}

.ai-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.ai-title {
  display: flex;
  align-items: center;
  gap: 12px;

  h2 { margin: 0; font-size: 1.5rem; color: #1a1a2e; }
}

.ai-icon { font-size: 2rem; }

.health-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: #f8f9fa;
  border-radius: 20px;
  font-size: 0.9rem;
  font-weight: 500;
}

.dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: #dc3545;
  &.green { background: #28a745; }
  &.red { background: #dc3545; }
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}

.stat-card {
  background: #fff;
  border: 1px solid #e9ecef;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.stat-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px solid #f0f0f0;

  h4 { margin: 0; font-size: 0.95rem; color: #333; }
}

.stat-icon { font-size: 1.5rem; }

.stat-body {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9rem;

  span { color: #6c757d; }
  strong { color: #1a1a2e; }
}

.stat-section-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #2563eb;
  margin-top: 8px;
  padding: 4px 0;
  border-top: 1px dashed #e0e0e0;
  letter-spacing: 0.5px;
}

.stat-row.highlight {
  background: #f0fdf4;
  padding: 4px 8px;
  border-radius: 6px;
  border-left: 3px solid #28a745;
}

.test-metric {
  color: #28a745 !important;
  font-size: 1rem;
}

.status-badge {
  padding: 2px 10px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 600;
  color: white;

  &.green { background: #28a745; }
}

.global-card {
  background: #fff;
  border: 1px solid #e9ecef;
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
}

.global-stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.global-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;

  span { font-size: 0.9rem; color: #6c757d; }
}

.big-number {
  font-size: 2.5rem;
  font-weight: 700;
  color: #2563eb;
}

.green-text { color: #28a745 !important; }

.btn-danger {
  padding: 12px 24px;
  background: #dc3545;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;

  &:hover { background: #c82333; }
  &:disabled { opacity: 0.6; cursor: not-allowed; }
}

.loading {
  text-align: center;
  padding: 40px;
  color: #6c757d;
}

@media (max-width: 768px) {
  .stats-grid { grid-template-columns: 1fr; }
  .global-stats { flex-direction: column; gap: 16px; }
  .ai-header { flex-direction: column; gap: 12px; }
}
