application-dev.properties
.env
.env.*
*.pem
*.key
*.p12
*.jks

# Git
.git/
.gitignore

# Docker
Dockerfile*
.dockerignore
docker-compose*

# Logs
logs/
*.log

# Uploads locaux (montés via PVC en K8s)
uploads/
C:/
